{
  "name": "pi-harness",
  "version": "0.1.0",
  "description": "CLI-first, daemonized 3-tier multi-agent coding harness built on pi and ACP with native-scrollback TUI, automated git worktrees, live model catalog, and quota-aware routing.",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "pi-harness": "./src/cli.ts",
    "harness": "./src/cli.ts"
  },
  "scripts": {
    "install": "if [ \"$npm_command\" = \"run-script\" ] && [ -z \"$PI_HARNESS_IN_INSTALL_SH\" ]; then sh ./install.sh; fi",
    "proto:gen": "mkdir -p src/gen && protoc --proto_path=proto --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=src/gen --es_opt=target=ts proto/quota.proto",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun run proto:gen && tsc -p tsconfig.json",
    "test": "bun run typecheck && bun test test",
    "check:hot-update-install": "bun scripts/hot-update-install-check.ts",
    "check:storage-upgrade": "bun scripts/storage-upgrade-check.ts",
    "start": "bun run src/cli.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.9.0",
    "@ast-grep/cli": "0.51.3",
    "@bufbuild/protobuf": "^2.2.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-durable": "^1.6.0",
    "@earendil-works/pi-tui": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.26.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.2.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
